pipeline {
    agent any

    stages {
        stage('Execute unit tests'){
            parallel{

                stage('Unit Tests - Backend') {
            agent{
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-backend') {
                    sh '''
                        set +e
                        if [ ! -f go.mod ]; then
                            echo "Backend workspace is missing go.mod; check that the Jenkins Docker agent can access the mounted workspace." >&2
                            exit 1
                        fi

                        export GOPATH="${WORKSPACE}/.go"
                        export GOMODCACHE="${GOPATH}/pkg/mod"
                        export GOCACHE="${WORKSPACE}/.cache/go-build"
                        if ! mkdir -p "$GOMODCACHE" "$GOCACHE"; then
                            echo "Could not create Go caches under $WORKSPACE" >&2
                            exit 1
                        fi

                        go test -v -coverprofile coverage.out -covermode atomic ./... > test-output.txt 2>&1
                        test_status=$?
                        cat test-output.txt

                        coverage_status=0
                        if [ -f coverage.out ]; then
                            go tool cover -html=coverage.out -o coverage.html
                            coverage_status=$?
                        else
                            echo "Coverage report not generated; check that tests ran successfully." >&2
                            coverage_status=1
                        fi

                        go-junit-report < test-output.txt > test-results.xml
                        report_status=$?
                        if [ "$report_status" -eq 0 ] && ! grep -q '<testcase ' test-results.xml; then
                            echo "Backend JUnit report contains no testcases; check that tests ran in the Docker workspace." >&2
                            report_status=1
                        fi
                        rm -f test-output.txt

                        if [ "$report_status" -ne 0 ]; then
                            echo "Failed to generate backend JUnit report" >&2
                            exit "$report_status"
                        fi
                        if [ "$coverage_status" -ne 0 ]; then
                            echo "Failed to generate backend HTML coverage report" >&2
                            exit "$coverage_status"
                        fi
                        exit "$test_status"
                    '''
                }
            }

            post {
                always {
                    script {
                        def report = 'bugtracker-backend/test-results.xml'
                        if (fileExists(report) && readFile(report).contains('<testcase ')) {
                            junit report
                        } else {
                            echo 'Backend JUnit report is unavailable or contains no testcases.'
                        }

                        def coverageProfile = 'bugtracker-backend/coverage.out'
                        if (fileExists(coverageProfile)) {
                            def coverageReport = 'bugtracker-backend/coverage.html'
                            if (fileExists(coverageReport)) {
                                archiveArtifacts artifacts: coverageReport, fingerprint: true
                            } else {
                                echo 'Backend HTML coverage report is unavailable; it could not be published.'
                            }
                        } else {
                            echo 'Backend coverage profile is unavailable; HTML coverage report was not generated.'
                        }
                    }
                }
            }
        }

        stage('Unit Tests - Frontend') {
            agent{
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }

            steps {
                dir('bugtracker-frontend') {
                    sh '''
                        set +e
                        npm ci
                        CI=true npm test -- --watch=false --runInBand
                        test_status=$?

                        mkdir -p reports
                        if [ -d coverage ]; then
                            mv coverage reports/
                        fi

                        exit "$test_status"
                    '''
                }
            }

            post {
                always {
                    script {
                        def junitResults = 'bugtracker-frontend/test-results.xml'
                        if (fileExists(junitResults)) {
                            junit junitResults
                        } else {
                            echo 'Frontend JUnit report is unavailable.'
                        }

                        def coverageDir = 'bugtracker-frontend/reports/coverage'
                        if (fileExists(coverageDir + '/index.html')) {
                            publishHTML target: [
                                allowMissing: true,
                                alwaysLinkToLastBuild: false,
                                keepAll: true,
                                reportDir: coverageDir,
                                reportFiles: 'index.html',
                                reportName: 'Frontend Coverage Report'
                            ]
                        } else {
                            echo 'Frontend HTML coverage report is unavailable.'
                        }
                    }
                }
            }
        }

            }
        }
        
        stage('Launch application') {
            agent{
                docker{
                    image 'docker:27.0.5'
                    reuseNode true
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }

            steps{
                sh 'docker compose up --build -d'
            }
        }
        
        stage('API Tests') {
            agent {
                docker {
                    
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    args '-u 0 network=host'
                }
            }

            steps{
                dir('tests-api') {
                    sh 'npx wait-port http://localhost:8080/api/health -t 30000 '

                    sh 'npm ci'
                    sh 'npx playwright test'
                    
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
